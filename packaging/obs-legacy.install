# Після встановлення чи оновлення пакета: якщо програму вже ставив install.sh у домашню теку
# (~/.local/bin), pacman туди не пише, тож ту копію, її ярлик і службу сповіщень переймає сама
# програма з пакета — від імені того, хто ставить пакет (/usr/lib/obs-legacy/auto-update use-package).
_obs_legacy_use_package() {
  if [ -x /usr/lib/obs-legacy/auto-update ]; then
    /usr/lib/obs-legacy/auto-update use-package || true
  fi
}

post_install() { _obs_legacy_use_package; }
post_upgrade() { _obs_legacy_use_package; }
